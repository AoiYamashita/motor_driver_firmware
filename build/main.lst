 106:Core/Src/main.cpp **** 	{
 107:Core/Src/main.cpp **** 		if(rxHeader.StdId == CAN_RECEIVE_ID[0] && my_id < 4){
 108:Core/Src/main.cpp ****       char data[8] = {rxData[1],rxData[0],rxData[3],rxData[2],rxData[5],rxData[4],rxData[6],rxData[
 109:Core/Src/main.cpp ****       memcpy(Data,data,8);
 110:Core/Src/main.cpp ****       CAN_output = abs(Data[my_id]) > 10000 ? 10000 : Data[my_id];
 111:Core/Src/main.cpp ****     } 
 112:Core/Src/main.cpp ****     else if(rxHeader.StdId == CAN_RECEIVE_ID[1] && my_id >= 4){
 113:Core/Src/main.cpp ****       char data[8] = {rxData[1],rxData[0],rxData[3],rxData[2],rxData[5],rxData[4],rxData[6],rxData[
 114:Core/Src/main.cpp ****       memcpy(Data,data,8);
 115:Core/Src/main.cpp ****       CAN_output = abs(Data[my_id-4]) > 10000 ? 10000 : Data[my_id-4];
